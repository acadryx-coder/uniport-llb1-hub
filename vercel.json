{
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|Twitterbot|WhatsApp|Discordbot|TelegramBot|LinkedInBot|Slackbot|iMessage|Pinterest).*"
        }
      ],
      "destination": "/api/og?path=:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
